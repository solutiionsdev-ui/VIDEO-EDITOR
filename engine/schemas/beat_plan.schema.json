{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beat plan (planner output)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "hook",
    "music",
    "beats"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Working title for the reel, 2-6 words"
    },
    "hook": {
      "type": "string",
      "description": "One sentence: why the first beat works as a hook"
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mood",
        "bpm",
        "energy"
      ],
      "properties": {
        "mood": {
          "type": "string"
        },
        "bpm": {
          "type": "string"
        },
        "energy": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "layout",
          "graphic",
          "caption_style",
          "highlight_words",
          "broll",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Optional 1-3 word name for the beat board, e.g. Hook, The brief"
          },
          "from": {
            "type": "integer",
            "minimum": 1,
            "description": "First candidate id in this beat"
          },
          "to": {
            "type": "integer",
            "minimum": 1,
            "description": "Last candidate id in this beat (inclusive)"
          },
          "layout": {
            "type": "string"
          },
          "graphic": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "component",
                  "props",
                  "anchor"
                ],
                "properties": {
                  "component": {
                    "type": "string"
                  },
                  "props": {
                    "type": "object"
                  },
                  "anchor": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom",
                      "below-card",
                      "center"
                    ]
                  }
                }
              }
            ]
          },
          "caption_style": {
            "type": "string",
            "enum": [
              "normal",
              "emphasis"
            ]
          },
          "highlight_words": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 6
          },
          "broll": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "note": {
            "type": "string",
            "description": "One short line: why this choice"
          }
        }
      }
    }
  }
}
